services:

  wallet-api:

    image: {{ image_repository }}:{{ image_tag }}

    container_name: miniwallet_api_container

    restart: unless-stopped

    ports:
      - "8084:8084"

    environment:

      ASPNETCORE_ENVIRONMENT: "{{ aspnet_environment }}"

      ASPNETCORE_URLS: "http://+:8084"

      OpenBao__Address: "{{ openbao_address }}"

      OpenBao__RoleId: "{{ openbao_role_id }}"

      OpenBao__SecretId: "{{ openbao_secret_id }}"

      OpenBao__SecretPath: "{{ openbao_secret_path }}"

    healthcheck:

      test:
        [
          "CMD",
          "wget",
          "--no-verbose",
          "--tries=1",
          "--spider",
          "http://localhost:8084/health"
        ]

      interval: 30s

      timeout: 10s

      retries: 3

      start_period: 20s